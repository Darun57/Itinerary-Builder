def _count_location_days(text: str, location: str) -> int:
    location_key = _normalize_destination_key(location)
    if not location_key:
        return 0

    count = 0
    for line in _split_values(text):
        if location_key in _normalize_destination_key(line):
            count += 1
    return count


def _count_location_days_in_itinerary(itinerary_text: str, location: str) -> int:
    location_key = _normalize_destination_key(location)
    if not location_key:
        return 0

    count = 0
    for day_section in split_itinerary_into_days(itinerary_text):
        day_text = " ".join(
            [str(day_section.get("heading") or ""), " ".join(str(item.get("content") or "") for item in day_section.get("items", []))]
        ).lower()
        if location_key in day_text:
            count += 1
    return count


def _count_location_days_in_trip_context(trip_context: TripContext, location: str) -> int:
    location_key = _normalize_destination_key(location)
    if not location_key:
        return 0
    count = 0
    for day_plan in trip_context.daily_plan:
        day_text = " ".join([day_plan.primary_island, " ".join(day_plan.attractions), " ".join(day_plan.activities)]).lower()
        if location_key in _normalize_destination_key(day_text):
            count += 1
    return count


def _hotel_stay_text(hotel_row: dict[str, object], trip_context: TripContext) -> str:
    location = str(hotel_row.get("location") or "").strip()
    hotel_name = str(hotel_row.get("hotel_name") or "").strip()
    stay_days = int(trip_context.hotel_stay_map.get(hotel_name, 0))
    if stay_days == 0:
        stay_days = _count_location_days_in_trip_context(trip_context, location)
    if stay_days > 0:
        return f"{stay_days} Night" if stay_days == 1 else f"{stay_days} Nights"
    return "As Per Itinerary"


def _day_transport_lines(trip_context: TripContext, day_number: int) -> list[str]:
    movement = get_day_movement(trip_context, day_number)
    if movement and is_travel_day(trip_context, day_number):
        route = get_day_route(trip_context, day_number)
        transport_name = movement.transport_name or movement.transport_mode or "Transfer"
        lines = [f"Transport: {transport_name}"]
        if movement.transport_mode:
            lines.append(f"Mode: {movement.transport_mode}")
        if route:
            lines.append(f"Route: {route}")
        if movement.departure_time:
            lines.append(f"Departure: {movement.departure_time}")
        if movement.arrival_time:
            lines.append(f"Arrival: {movement.arrival_time}")
        return lines
    fallback = get_day_transport(trip_context, day_number).strip()
    if fallback and fallback.lower() != "no transfer":
        route = get_day_route(trip_context, day_number)
        lines = [f"Transport: {fallback}"]
        if route:
            lines.append(f"Route: {route}")
        return lines
    if day_number == 1:
        return ["Transport: Private Transfer"]
    return ["Transport: Leisure"]


