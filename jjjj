        story.append(_fit_image(image_path, 6.15 * inch, 2.35 * inch))
    else:
        story.append(Spacer(1, 0.08 * inch))
    story.append(Spacer(1, 0.05 * inch))
    for label, content in [
        ("Morning", day.morning),
        ("Afternoon", day.afternoon),
        ("Evening", day.evening),
        ("Overnight / Departure" if day_number == request.number_of_days else "Overnight Stay", day.overnight),
    ]:
        story.append(Paragraph(_escape_text(label), styles["label"]))
        story.append(Paragraph(_escape_text(content), styles["body"]))
        story.append(Spacer(1, 0.03 * inch))
        story.append(HRFlowable(width="100%", thickness=0.25, color=COLORS["line"]))
        story.append(Spacer(1, 0.03 * inch))
    story.append(HRFlowable(width="100%", thickness=0.4, color=COLORS["soft_grey"]))
    story.append(Spacer(1, 0.03 * inch))


def validate_itinerary_layout(story: list) -> None:
    previous_was_page_break = False
    for flowable in story:
        flowable_name = flowable.__class__.__name__
        if flowable_name == "PageBreak":
            if previous_was_page_break:
                raise ValueError("Invalid itinerary layout: consecutive page breaks detected.")
            previous_was_page_break = True
            continue
        previous_was_page_break = False

    day_titles = sum(1 for flowable in story if getattr(getattr(flowable, "style", None), "name", "") == "day_title")
    LOGGER.debug("Detected day headers: %s", day_titles)
    if day_titles == 0:
        raise ValueError("Invalid itinerary layout: no day headers were rendered.")


