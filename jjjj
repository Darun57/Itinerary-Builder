def split_itinerary_into_days(itinerary_text: str) -> list[dict[str, object]]:
    sections: list[dict[str, object]] = []
    current_day: dict[str, object] | None = None
    for raw_line in itinerary_text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        lower_line = line.lower()
        if lower_line.startswith("day "):
            current_day = {"heading": line, "items": []}
            sections.append(current_day)
            continue
        if current_day is None:
            current_day = {"heading": "Overview", "items": []}
            sections.append(current_day)
        label = ""
        content = line
        if ":" in line:
            possible_label, remainder = line.split(":", 1)
            normalized_label = possible_label.strip().lower()
            if normalized_label in SECTION_LABELS:
                label = possible_label.strip().title()
                content = remainder.strip()
        current_day["items"].append({"label": label, "content": content})
    return sections


def _daily_plan_places(daily_island_plan: str) -> list[str]:
    places: list[str] = []
    for raw_line in str(daily_island_plan or "").splitlines():
        if ":" in raw_line:
            raw_line = raw_line.split(":", 1)[1]
        for value in _split_values(raw_line):
            label = _clean_destination_label(value)
            if label:
                places.append(label)
    return _unique_values(places)


def _extract_itinerary_destinations(itinerary_text: str) -> list[str]:
    destinations: list[str] = []
    for raw_line in itinerary_text.splitlines():
        lower_line = raw_line.lower()
        for keyword in [
            "port blair",
            "swaraj dweep",
            "shaheed dweep",
            "baratang",
            "diglipur",
            "ross island",
            "north bay",
            "jolly buoy",
            "red skin",
            "chidiya tapu",
            "wandoor",
            "long island",
            "little andaman",
        ]:
            if keyword in lower_line:
                destinations.append(_clean_destination_label(keyword.title()))
    return _unique_values(destinations)


def _highlight_data(trip_context: TripContext, itinerary_text: str) -> dict[str, object]:
    destinations = _unique_values(
        [_clean_destination_label(value) for value in trip_context.destinations]
        + [_clean_destination_label(day.primary_island) for day in trip_context.daily_plan if day.primary_island]
        + [_clean_destination_label(value) for day in trip_context.daily_plan for value in day.attractions]
        + _extract_itinerary_destinations(itinerary_text)
    )
    if not destinations:
        destinations = [_clean_destination_label(trip_context.trip_metadata.destination or "Andaman Islands")]

    activities = _unique_values(list(trip_context.activities) + _extract_activity_terms(itinerary_text))
    travel_style = _unique_values(list(trip_context.trip_metadata.travel_style) + _split_values(trip_context.trip_metadata.trip_type))
    selected_hotels = _unique_values(list(trip_context.selected_hotels))
    meal_preferences = _unique_values(list(trip_context.meal_preferences))
    transport_preferences = _unique_values([trip_context.transport.transfer_type] + list(trip_context.transport.preferred_ferries))
    special_occasions = _unique_values(list(trip_context.special_occasions))

    return {
        "destinations": destinations,
        "activities": activities,
        "travel_style": travel_style,
        "hotel_category": str(trip_context.trip_metadata.hotel_category_preference or trip_context.trip_metadata.budget_category or "Selected").strip(),
        "selected_hotels": selected_hotels,
        "meal_preferences": meal_preferences,
        "transport_preferences": transport_preferences,
        "special_occasions": special_occasions,
        "duration": f"{trip_context.trip_metadata.number_of_days} Days / {trip_context.trip_metadata.number_of_nights} Nights",
        "pace": str(trip_context.trip_metadata.trip_pace or "Balanced").strip(),
        "budget": str(trip_context.trip_metadata.budget_category or "").strip(),
    }


